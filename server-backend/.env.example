# ===== IssueFlow backend (server-backend) =====
# Copy to .env for local dev. In production, set these in your host's
# environment variables dashboard instead (never commit real values).

# Port the Express server listens on (most hosts set this for you)
PORT=7001

# MongoDB connection string (local, or MongoDB Atlas in production)
# Local:  mongodb://127.0.0.1:27017/issueflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/issueflow
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/issueflow

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Separate secret for refresh tokens (must differ from JWT_SECRET).
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# Frontend origin allowed by Socket.IO CORS (server/services/socketServices.js).
# Must match the frontend URL exactly: no trailing slash.
# Local: http://localhost:5173   Production: https://your-app.vercel.app
HOST=http://localhost:5173

# Frontend base URL used to build invite links in emails
# (controllers/inviteController.js). No trailing slash.
CLIENT_URL=http://localhost:5173

# Gmail account that sends invite emails + its App Password
# (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_USER=your-email@gmail.com
GOOGLE_APP_PASSWORD=your-16-char-app-password

# Google Gemini API key for the AI features (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# ---- Rate limits (the numbers are in config/rateLimits.js)
# How many proxies are in front of the server. 1 on Render. Use 0 only when you run it on your own computer with nothing in front.
# Wrong value = all users look like one ip and share one limit. After the first request the server logs the ip it sees: check it.
TRUST_PROXY=1

# The free Gemini key allows a fixed number of requests PER DAY for the whole app. Set this to the limit of your key.
AI_DAILY_LIMIT=20
# How many of them one user may use per day, so one person cannot use up the day for everybody.
AI_USER_DAILY_LIMIT=3

# Mails (invites and password resets) per day for the whole app. A Gmail account is stopped by Google at about 500 a day.
MAIL_DAILY_LIMIT=300

# The in-memory cache is on by default. CACHE_ENABLED=false turns it off (to measure its effect with scripts/benchmark.js)
CACHE_ENABLED=true
