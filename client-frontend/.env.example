# ===== IssueFlow frontend (client-frontend) =====
# Vite only exposes variables prefixed with VITE_.
# In Vercel: Project Settings > Environment Variables (then redeploy,
# since Vite bakes these in at build time).

# Backend base URL, used for both axios (configs/api.js) and Socket.IO (src/socket.js).
# No trailing slash.
# Local: http://localhost:7001   Production: https://your-backend-url
VITE_BASE_URL=http://localhost:7001
